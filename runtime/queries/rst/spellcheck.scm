; Prose in headings, paragraphs, lists, and quotations. Directive bodies have
; no parsed inline structure, so leave them opt-in instead of checking code.
[
  (title)
  (paragraph)
  (term)
  (classifier)
  (line)
  (attribution)
] @spell

[
  (literal)
  (literal_block)
  (doctest_block)
  (interpreted_text)
  (reference)
  (standalone_hyperlink)
  (substitution_reference)
  (inline_target)
  (footnote_reference)
  (citation_reference)
] @nospell
